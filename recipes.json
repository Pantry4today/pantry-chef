async function fetchCloudCatalogs() {
    try {
        showToast("Fetching latest recipes from cloud...");
        const response = await fetch('https://yourusername.github.io/pantry-chef/recipes.json');
        const data = await response.json();
        
        // Populate your cloud catalog dynamically
        window.CLOUD_CATALOG = data.packs;
        openCatalogModal();
    } catch (err) {
        showToast("Could not load cloud catalogs. Offline mode active.");
    }
}
